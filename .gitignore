# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated from committed ARB localization sources.
/lib/app/l10n/generated/

# Caches del paquete API; los serializers .g.dart y su lock si se versionan.
/packages/fudi_api/.dart_tool/
/packages/fudi_api/build/
/packages/fudi_api/.openapi-generator/

# Local agent tooling, not application source.
/.agents/
/.hallmark/
**/__pycache__/
node_modules/

# Local credentials; share only explicit examples.
.env
.env.*
!.env.example
!.env.template

# Native build reports and caches.
/android/build/

# Reproducible visual QA outputs stay local. Keep human-readable reports.
/docs/mig003b/evidence/*.png
/docs/mig003b/evidence/*.json
/docs/mig003b/implementation-evidence/*
!/docs/mig003b/implementation-evidence/README.md
/docs/mig010a/evidence/*
!/docs/mig010a/evidence/README.md
/docs/mig011/evidence/*
!/docs/mig011/evidence/README.md
